# PostgreSQL 16 connection string for local development / Docker Compose
DATABASE_URL="postgresql://appuser:localdevpassword@localhost:5432/equipflow?schema=public"

# Isolated PostgreSQL 16 database used by automated integration and E2E test suites
TEST_DATABASE_URL="postgresql://appuser:localdevpassword@localhost:5432/equipflow_test?schema=public"

# JWT signing secret (required at runtime; use Secret Manager in production)
JWT_SECRET="replace-with-a-local-development-secret"

# Runtime HTTP bind address and port (Cloud Run injects PORT=8080)
HOST="0.0.0.0"
PORT=3000
NODE_ENV="development"

# Allowed CORS origin for local Vite dev server
CLIENT_ORIGIN="http://localhost:5173"

# Password for seeded demo accounts (required when seeding in production; defaults to Password123! in local dev)
DEMO_USER_PASSWORD="replace-with-a-seed-password"
