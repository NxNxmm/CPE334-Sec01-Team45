# Docker Compose PostgreSQL 16 settings (override in .env when needed)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=equipflow
POSTGRES_PORT=5432
APP_PORT=8080

# PostgreSQL 16 connection string for local development outside Docker Compose
DATABASE_URL="postgresql://appuser:localdevpassword@localhost:5432/equipflow?schema=public"

# Dedicated PostgreSQL 16 database required for destructive test resets and automated suites (must be distinct from DATABASE_URL)
TEST_DATABASE_URL="postgresql://appuser:localdevpassword@localhost:5432/equipflow_test?schema=public"

# JWT signing secret (required at runtime; use Secret Manager in production)
JWT_SECRET="replace-with-a-local-development-secret"

# Runtime HTTP bind address and port (Cloud Run injects PORT=8080)
HOST="0.0.0.0"
PORT=3000
NODE_ENV="development"

# Allowed CORS origin for local Vite dev server
CLIENT_ORIGIN="http://localhost:5173"

# Production seed password (required when NODE_ENV="production"; leave empty in local dev/test to use the deterministic local fixture password)
DEMO_USER_PASSWORD=""
